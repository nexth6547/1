{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notre Première Année",
  "version": "0.1.0",
  "identifier": "fr.notrepremiereannee.souvenirs",
  "build": {
    "frontendDist": [
      "../index.html",
      "../style.css",
      "../script.js"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notre Première Année",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
